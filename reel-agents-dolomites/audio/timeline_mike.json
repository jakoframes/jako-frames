  },
  {
   "id": "C01",
   "character": "Claude",
   "text": "Your agents.",
   "file": "lines/C01.wav",
   "start_s": 1.23,
   "end_s": 2.33,
   "speech_start_s": 1.29,
   "speech_end_s": 2.27,
   "speech_start_frame": 31,
   "speech_end_frame": 54,
   "shot": 2
  },
  {
   "id": "J02",
   "character": "Jako",
   "text": "Whaaat?",
   "file": "lines/J02.wav",
   "start_s": 2.49,
   "end_s": 3.692,
   "speech_start_s": 2.55,
   "speech_end_s": 3.46,
   "speech_start_frame": 61,
   "speech_end_frame": 83,
   "shot": 3
  },
  {
   "id": "C02",
   "character": "Claude",
   "text": "Yep. Planner, analyst, caption writer, video director... and trend scout.",
   "file": "lines/C02.wav",
   "start_s": 3.8,
   "end_s": 8.91,
   "speech_start_s": 3.86,
   "speech_end_s": 8.85,
   "speech_start_frame": 93,
   "speech_end_frame": 212,
   "shot": 4
  },
  {
   "id": "J03",
   "character": "Jako",
   "text": "What is this place?",
   "file": "lines/J03.wav",
   "start_s": 9.24,
   "end_s": 10.69,
   "speech_start_s": 9.3,
   "speech_end_s": 10.45,
   "speech_start_frame": 223,
   "speech_end_frame": 251,
   "shot": 5
  },
  {
   "id": "C03",
   "character": "Claude",
   "text": "Italy. Dolomites.",
   "file": "lines/C03.wav",
   "start_s": 10.94,
   "end_s": 12.84,
   "speech_start_s": 11.0,
   "speech_end_s": 12.78,
   "speech_start_frame": 264,
   "speech_end_frame": 307,
   "shot": 6
  },
  {
   "id": "J04",
   "character": "Jako",
   "text": "Why Dolomites?",
   "file": "lines/J04.wav",
   "start_s": 13.32,
   "end_s": 14.94,
   "speech_start_s": 13.38,
   "speech_end_s": 14.7,
   "speech_start_frame": 321,
   "speech_end_frame": 353,
   "shot": 7
  },
  {
   "id": "C04",
   "character": "Claude",
   "text": "'Cause you love it here.",
   "file": "lines/C04.wav",
   "start_s": 14.94,
   "end_s": 16.79,
   "speech_start_s": 15.0,
   "speech_end_s": 16.73,
   "speech_start_frame": 360,
   "speech_end_frame": 402,
   "shot": 8
  },
  {
   "id": "J05",
   "character": "Jako",
   "text": "What are they doing?",
   "file": "lines/J05.wav",
   "start_s": 17.12,
   "end_s": 18.369,
   "speech_start_s": 17.18,
   "speech_end_s": 18.14,
   "speech_start_frame": 412,
   "speech_end_frame": 435,
   "shot": 9
  },
  {
   "id": "C05",
   "character": "Claude",
   "text": "Just chilling.",
   "file": "lines/C05.wav",
   "start_s": 18.36,
   "end_s": 19.29,
   "speech_start_s": 18.42,
   "speech_end_s": 19.23,
   "speech_start_frame": 442,
   "speech_end_frame": 462,
   "shot": 9
  },
  {
   "id": "J06",
   "character": "Jako",
   "text": "Why?",
   "file": "lines/J06.wav",
   "start_s": 19.42,
   "end_s": 20.248,
   "speech_start_s": 19.48,
   "speech_end_s": 20.0,
   "speech_start_frame": 468,
   "speech_end_frame": 480,
   "shot": 9
  },
  {
   "id": "C06",
   "character": "Claude",
   "text": "No task yet. Ask them something, they'll come to the office.",
   "file": "lines/C06.wav",
   "start_s": 20.22,
   "end_s": 23.32,
   "speech_start_s": 20.28,
   "speech_end_s": 23.26,
   "speech_start_frame": 487,
   "speech_end_frame": 558,
   "shot": 9
  },
  {
   "id": "J07",
   "character": "Jako",
   "text": "Really?",
   "file": "lines/J07.wav",
   "start_s": 23.5,
   "end_s": 24.393,
   "speech_start_s": 23.56,
   "speech_end_s": 24.15,
   "speech_start_frame": 565,
   "speech_end_frame": 580,
   "shot": 9
  },
  {
   "id": "C07",
   "character": "Claude",
   "text": "Yep. Call 'em.",
   "file": "lines/C07.wav",
   "start_s": 24.37,
   "end_s": 25.8,
   "speech_start_s": 24.43,
   "speech_end_s": 25.74,
   "speech_start_frame": 586,
   "speech_end_frame": 618,
   "shot": 9
  },
  {
   "id": "J08",
   "character": "Jako",
   "text": "Come to the office!",
   "file": "lines/J08.wav",
   "start_s": 26.08,
   "end_s": 28.596,
   "speech_start_s": 26.14,
   "speech_end_s": 27.39,
   "speech_start_frame": 627,
   "speech_end_frame": 657,
   "shot": 10
  },
  {
   "id": "C08",
   "character": "Claude",
   "text": "They're on your project now. You don't need to do anything.",
   "file": "lines/C08.wav",
   "start_s": 31.93,
   "end_s": 34.79,
   "speech_start_s": 31.99,
   "speech_end_s": 34.73,
   "speech_start_frame": 768,
   "speech_end_frame": 834,
   "shot": 12
  },
  {
   "id": "J09",
   "character": "Jako",
   "text": "Ohhh, this one's planning, this one's analysing?",
   "file": "lines/J09.wav",
   "start_s": 35.02,
   "end_s": 39.139,
   "speech_start_s": 35.08,
   "speech_end_s": 38.89,
   "speech_start_frame": 842,
   "speech_end_frame": 933,
   "shot": 12
  },
  {
   "id": "C09",
   "character": "Claude",
   "text": "You're right.",
   "file": "lines/C09.wav",
   "start_s": 39.11,
   "end_s": 40.01,
   "speech_start_s": 39.17,
   "speech_end_s": 39.95,
   "speech_start_frame": 940,
   "speech_end_frame": 959,
   "shot": 12
  },
  {
   "id": "J10",
   "character": "Jako",
   "text": "So that's how my agents work.",
   "file": "lines/J10.wav",
   "start_s": 40.34,
   "end_s": 42.534,
   "speech_start_s": 40.4,
   "speech_end_s": 42.3,
   "speech_start_frame": 970,
   "speech_end_frame": 1015,
   "shot": 13
  },
  {
   "id": "C10",
   "character": "Claude",
   "text": "Everything is for you.",
   "file": "lines/C10.wav",
   "start_s": 42.56,
   "end_s": 44.1,
   "speech_start_s": 42.62,
   "speech_end_s": 44.04,
   "speech_start_frame": 1023,
   "speech_end_frame": 1057,
   "shot": 13
  },
  {
   "id": "J11",
   "character": "Jako",
   "text": "Thank you. Let's relax.",
   "file": "lines/J11.wav",
   "start_s": 44.48,
   "end_s": 46.814,
   "speech_start_s": 44.54,
   "speech_end_s": 46.57,
   "speech_start_frame": 1069,
   "speech_end_frame": 1118,
   "shot": 14
  }
 ],
